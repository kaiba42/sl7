+    #[test]
+    fn sharded_cache_enforces_total_limits_and_clears() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let root = temp.path().join("store");
+        let _store = crate::Store::init(&root)?;
+        let mut writer = pack::Writer::new(&root)?;
+        for k in 0..64_u8 {
+            let bytes = vec![k; 32768];
+            writer.add(crate::chunk::identity(&bytes), &bytes)?;
+        }
+        let (_, _, locations) = writer.finish(&root)?;
+        let cache = ReadCache::sharded(65536, 2, 2);
+        for (k, loc) in locations.iter().enumerate() {
+            assert_eq!(*cache.read(&root, loc)?, vec![k as u8; 32768]);
+            assert!(cache.stats().cached_bytes <= 65536);
+            assert!(cache.stats().open_packs <= 2);
+        }
+        assert_eq!(cache.stats().active_loads, 0);
+        assert_eq!(cache.stats().max_parallel_loads, 1);
+        cache.clear();
+        assert_eq!(cache.stats().cached_bytes, 0);
+        assert_eq!(cache.stats().open_packs, 0);
+        assert_eq!(cache.stats().map_bytes, 0);
+        Ok(())
+    }
