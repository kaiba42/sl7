+// Experimental strict-budget cache sharding, evaluated separately from main.
+#[derive(Default)]
+struct Activity {
+    active: std::sync::atomic::AtomicUsize,
+    peak: std::sync::atomic::AtomicUsize,
+    requested: std::sync::atomic::AtomicU64,
+}
+pub(crate) struct ReadCache {
+    shards: Vec<CacheShard>,
+    activity: Arc<Activity>,
+}
+impl Default for ReadCache {
+    fn default() -> Self {
+        Self::sharded(128 * 1024 * 1024, 64, 16)
+    }
+}
+impl ReadCache {
+    #[cfg(test)]
+    fn new(bytes: usize, packs: usize) -> Self {
+        Self::sharded(bytes, packs, 1)
+    }
+    fn sharded(bytes: usize, packs: usize, n: usize) -> Self {
+        assert!(n > 0 && packs >= n);
+        let activity = Arc::new(Activity::default());
+        let shards = (0..n)
+            .map(|_| {
+                let mut shard = CacheShard::new(bytes / n, packs / n);
+                shard.activity = activity.clone();
+                let state = shard.state.get_mut().unwrap();
+                state.map_limit /= n;
+                state.map_entry_limit /= n;
+                shard
+            })
+            .collect();
+        Self { shards, activity }
+    }
+    fn map_shard(&self, key: &MapKey) -> &CacheShard {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        key.hash(&mut h);
+        &self.shards[h.finish() as usize % self.shards.len()]
+    }
+    pub fn map(&self, key: &MapKey) -> Option<Arc<[Extent]>> {
+        self.map_shard(key).map(key)
+    }
+    pub fn remember_map(&self, key: MapKey, extents: Arc<[Extent]>) {
+        self.map_shard(&key).remember_map(key, extents)
+    }
+    pub fn map_query(&self) {
+        self.shards[0].map_query()
+    }
+    pub fn map_fallback(&self) {
+        self.shards[0].map_fallback()
+    }
+    pub fn request(&self, bytes: u64) {
+        self.activity
+            .requested
+            .fetch_add(bytes, std::sync::atomic::Ordering::Relaxed);
+    }
+    pub fn read(&self, root: &Path, loc: &pack::Location) -> Result<Arc<Vec<u8>>> {
+        self.shards[loc.hash[0] as usize % self.shards.len()].read(root, loc)
+    }
+    #[cfg(test)]
+    fn read_with(
+        &self,
+        root: &Path,
+        loc: &pack::Location,
+        load: impl FnOnce(&File, &pack::Location) -> Result<Vec<u8>>,
+    ) -> Result<Arc<Vec<u8>>> {
+        self.shards[loc.hash[0] as usize % self.shards.len()].read_with(root, loc, load)
+    }
+    pub fn clear(&self) {
+        for shard in &self.shards {
+            shard.clear();
+        }
+    }
+    pub fn stats(&self) -> CacheStats {
+        let mut total = CacheStats::default();
+        for shard in &self.shards {
+            let s = shard.stats();
+            total.chunk_hits += s.chunk_hits;
+            total.chunk_misses += s.chunk_misses;
+            total.pack_opens += s.pack_opens;
+            total.decoded_bytes += s.decoded_bytes;
+            total.cached_bytes += s.cached_bytes;
+            total.open_packs += s.open_packs;
+            total.map_hits += s.map_hits;
+            total.map_misses += s.map_misses;
+            total.map_queries += s.map_queries;
+            total.map_fallbacks += s.map_fallbacks;
+            total.map_bytes += s.map_bytes;
+            total.map_windows += s.map_windows;
+            total.duplicate_loads += s.duplicate_loads;
+            total.load_seconds += s.load_seconds;
+        }
+        total.active_loads = self
+            .activity
+            .active
+            .load(std::sync::atomic::Ordering::Relaxed);
+        total.max_parallel_loads = self
+            .activity
+            .peak
+            .load(std::sync::atomic::Ordering::Relaxed);
+        total.requested_bytes = self
+            .activity
+            .requested
+            .load(std::sync::atomic::Ordering::Relaxed);
+        total
+    }
+}
