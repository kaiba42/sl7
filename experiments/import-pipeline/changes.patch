@@ -0,0 +1,101 @@
+use crate::{
+    Error, Result,
+    chunk::{Chunker, Hash},
+};
+use sha2::{Digest, Sha256};
+use std::{fs::File, io::BufReader, sync::mpsc, thread};
+
+pub(crate) trait Chunks {
+    fn next_chunk(&mut self) -> Result<Option<Vec<u8>>>;
+    fn finish(&mut self) -> Result<Hash>;
+}
+struct Serial<'a> {
+    chunks: Chunker<BufReader<&'a File>>,
+    digest: Sha256,
+}
+impl Chunks for Serial<'_> {
+    fn next_chunk(&mut self) -> Result<Option<Vec<u8>>> {
+        let bytes = self.chunks.next_chunk()?;
+        if let Some(bytes) = &bytes {
+            self.digest.update(bytes);
+        }
+        Ok(bytes)
+    }
+    fn finish(&mut self) -> Result<Hash> {
+        Ok(std::mem::take(&mut self.digest).finalize().into())
+    }
+}
+struct Pipelined<'a> {
+    receiver: mpsc::Receiver<Vec<Vec<u8>>>,
+    pending: std::vec::IntoIter<Vec<u8>>,
+    producer: Option<thread::ScopedJoinHandle<'a, Result<Hash>>>,
+}
+impl Chunks for Pipelined<'_> {
+    fn next_chunk(&mut self) -> Result<Option<Vec<u8>>> {
+        if let Some(bytes) = self.pending.next() {
+            return Ok(Some(bytes));
+        }
+        self.pending = self.receiver.recv().unwrap_or_default().into_iter();
+        Ok(self.pending.next())
+    }
+    fn finish(&mut self) -> Result<Hash> {
+        self.producer
+            .take()
+            .unwrap()
+            .join()
+            .map_err(|_| Error::Invalid("chunk producer panicked".into()))?
+    }
+}
+pub(crate) fn with_chunks<T>(
+    file: &File,
+    pipeline: bool,
+    consume: impl FnOnce(&mut dyn Chunks) -> Result<T>,
+) -> Result<T> {
+    if !pipeline {
+        return consume(&mut Serial {
+            chunks: Chunker::new(BufReader::new(file)),
+            digest: Sha256::new(),
+        });
+    }
+    eprintln!("sl7: chunk pipeline enabled");
+    thread::scope(|scope| {
+        let batch_size = if std::env::var("SL7_PIPELINE").as_deref() == Ok("2") {
+            16
+        } else {
+            1
+        };
+        let (sender, receiver) = mpsc::sync_channel(32 / batch_size);
+        let producer = scope.spawn(move || {
+            let mut chunks = Chunker::new(BufReader::new(file));
+            let mut digest = Sha256::new();
+            let mut batch = Vec::with_capacity(batch_size);
+            while let Some(bytes) = chunks.next_chunk()? {
+                digest.update(&bytes);
+                batch.push(bytes);
+                if batch.len() == batch_size {
+                    if sender
+                        .send(std::mem::replace(
+                            &mut batch,
+                            Vec::with_capacity(batch_size),
+                        ))
+                        .is_err()
+                    {
+                        return Err(Error::SourceChanged("chunk consumer stopped".into()));
+                    }
+                }
+            }
+            if !batch.is_empty() && sender.send(batch).is_err() {
+                return Err(Error::SourceChanged("chunk consumer stopped".into()));
+            }
+            Ok(digest.finalize().into())
+        });
+        let mut stream = Pipelined {
+            receiver,
+            pending: Vec::new().into_iter(),
+            producer: Some(producer),
+        };
+        // On any consumer error, stream drops its receiver before scope joins.
+        // A blocked producer then exits; bounded backpressure cannot deadlock.
+        consume(&mut stream)
+    })
+}
